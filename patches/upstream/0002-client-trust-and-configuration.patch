+fn read_tls_roots(path: &Path) -> io::Result<RootCertStore> {
+    let mut roots = RootCertStore::empty();
+    for entry in WalkDir::new(path) {
+        let entry = entry.map_err(io::Error::other)?;
+        if !entry.file_type().is_file() {
+            continue;
+        }
+        let path = entry.path();
+        let Some(extension) = path.extension() else {
+            continue;
+        };
+        if extension.eq_ignore_ascii_case("pem") {
+            let previous = roots.len();
+            for cert in certs(&mut BufReader::new(File::open(path)?)) {
+                roots.add(cert?).map_err(|_| {
+                    io::Error::new(io::ErrorKind::InvalidData, "invalid trust certificate")
+                })?;
+            }
+            if roots.len() == previous {
+                return Err(io::Error::new(
+                    io::ErrorKind::InvalidData,
+                    "PEM file contains no certificates",
+                ));
+            }
+        } else if extension.eq_ignore_ascii_case("der") {
+            let cert = CertificateDer::from(std::fs::read(path)?);
+            roots.add(cert).map_err(|_| {
+                io::Error::new(io::ErrorKind::InvalidData, "invalid trust certificate")
+            })?;
+        }
+    }
+    if roots.is_empty() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "no trust certificates",
+        ));
+    }
+    Ok(roots)
+}
