+    use rust_rcs_client::provisioning::wap_provisioning_doc::read_wap_provisioning_doc;
+    for (xml, expected) in [
+        ("<wap-provisioningdoc>  </wap-provisioningdoc>", true),
+        ("<wap-provisioningdoc>  </wap-provisioningdoc", false),
+        ("<wap-provisioningdoc>  </wap-provisioningdoc ", false),
+    ] {
+        let mut reader = Reader::from_reader(std::io::Cursor::new(xml));
+        reader.config_mut().trim_text(true);
+        let mut buffer = Vec::new();
+        let Event::Start(start) = reader.read_event_into(&mut buffer).unwrap() else {
