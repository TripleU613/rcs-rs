+use rust_rcs_client::{context::Context, new_rcs_client, RcsRuntime};
+use std::{ffi::CString, ptr, sync::Arc};
+
+#[test]
+fn context_accepts_valid_roots_and_rejects_missing_roots() {
+    let path = std::env::temp_dir().join(format!("rcs-rs-eval-context-{}", std::process::id()));
+    std::fs::create_dir_all(path.join("certs")).unwrap();
+    let rt = Arc::new(tokio::runtime::Runtime::new().unwrap());
+    assert!(Context::new(path.to_str().unwrap(), Arc::clone(&rt)).is_err());
+    for (name, data) in [
+        ("root.pem", include_bytes!("fixtures/root.pem").as_slice()),
+        ("root.der", include_bytes!("fixtures/root.der").as_slice()),
+    ] {
+        std::fs::write(path.join("certs").join(name), data).unwrap();
+        // Construct and drop only; no DNS or HTTP request is submitted.
+        drop(Context::new(path.to_str().unwrap(), Arc::clone(&rt)).unwrap());
+        std::fs::remove_file(path.join("certs").join(name)).unwrap();
+    }
+    std::fs::remove_dir_all(path).unwrap();
+}
+
+#[test]
+fn c_constructor_returns_null_for_unusable_roots() {
+    let mut runtime = RcsRuntime {
+        rt: Arc::new(tokio::runtime::Runtime::new().unwrap()),
+    };
+    let path = std::env::temp_dir().join(format!("rcs-rs-eval-empty-{}", std::process::id()));
+    std::fs::create_dir(&path).unwrap();
+    let path_string = CString::new(path.to_str().unwrap()).unwrap();
+    let synthetic = CString::new("synthetic-identifier").unwrap();
+    let client = unsafe {
+        new_rcs_client(
+            &mut runtime,
+            0,
+            1,
+            1,
+            synthetic.as_ptr(),
+            synthetic.as_ptr(),
+            ptr::null(),
+            path_string.as_ptr(),
+            None,
+            ptr::null_mut(),
+            None,
+            ptr::null_mut(),
+            None,
+            ptr::null_mut(),
+        )
+    };
+    assert!(client.is_none());
+    std::fs::remove_dir(path).unwrap();
+}
