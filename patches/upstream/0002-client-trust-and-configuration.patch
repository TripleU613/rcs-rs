+        "<wap-provisioningdoc></wap-provisioningdoc\r\n",
+        "<wap-provisioningdoc/",
+        "<wap-provisioningdoc x=\"unclosed/",
+        "<wap-provisioningdoc bogus/>",
+        "<wap-provisioningdoc x=\"&unknown;\"/>",
+        "<wap-provisioningdoc x=\"1\" x=\"2\"/>",
+        "<wap-provisioningdoc bogus></wap-provisioningdoc>",
+    ] {
