+    for (xml, expected) in [
+        (VALID, true),
+        (&VALID[..VALID.len() - 1], false),
+        (
+            &VALID[..VALID.find("</wap-provisioningdoc>").unwrap()],
+            false,
+        ),
+    ] {
+        let mut reader = Reader::from_reader(std::io::Cursor::new(xml));
+        let mut buffer = Vec::new();
+        let Event::Start(start) = reader.read_event_into(&mut buffer).unwrap() else {
+            panic!("synthetic root missing")
+        };
+        assert_eq!(
+            read_wap_provisioning_doc(&mut reader, &mut Vec::new(), &start).is_ok(),
+            expected
+        );
+    }
