diff --git a/tests/digest_qop.rs b/tests/digest_qop.rs
new file mode 100644
index 0000000..e49d1df
--- /dev/null
+++ b/tests/digest_qop.rs
@@ -0,0 +1,96 @@
+use rust_rcs_core::security::authentication::digest::{
+    DigestAnswerParams, DigestChallenge, DigestCredentials,
+};
+
+fn answer(qop: Option<&[u8]>) -> DigestAnswerParams {
+    DigestAnswerParams {
+        realm: b"testrealm@host.com".to_vec(),
+        algorithm: Some(b"MD5".to_vec()),
+        username: b"Mufasa".to_vec(),
+        uri: b"/dir/index.html".to_vec(),
+        challenge: Some(DigestChallenge {
+            realm: b"testrealm@host.com".to_vec(),
+            nonce: b"dcd98b7102dd2f0e8b11d0f600bfb0c093".to_vec(),
+            algorithm: b"MD5".to_vec(),
+            domain: None,
+            opaque: None,
+            qop: qop.map(<[u8]>::to_vec),
+        }),
+        credentials: Some(DigestCredentials {
+            password: b"Circle Of Life".to_vec(),
+            client_data: Some(b"GET".to_vec()),
+            client_nonce: Some((b"0a4f113b".to_vec(), 1)),
+            entity_digest: None,
+            extra_params: Vec::new(),
+        }),
+    }
+}
+fn header(params: &DigestAnswerParams, algorithm: &[u8]) -> String {
+    match params.make_authorization_header(Some(algorithm), false, false) {
+        Ok(value) => String::from_utf8(value).unwrap(),
+        Err(_) => panic!("supported digest failed"),
+    }
+}
+#[test]
+fn unsupported_qop_does_not_fall_back_to_no_qop() {
+    for qop in [b"unsupported".as_slice(), b"", b"future-option"] {
+        let params = answer(Some(qop));
+        assert!(
+            params
+                .make_authorization_header(Some(b"MD5"), false, false)
+                .is_err(),
+            "unsupported qop was accepted"
+        );
+        assert!(
+            params.make_authorization_header(None, true, true).is_err(),
+            "unsupported qop emitted an initial/empty response"
+        );
+    }
+}
+#[test]
+fn missing_client_nonce_returns_error_instead_of_partial_header() {
+    let mut params = answer(Some(b"auth"));
+    params.credentials.as_mut().unwrap().client_nonce = None;
+    assert!(params
+        .make_authorization_header(Some(b"MD5"), false, false)
+        .is_err());
+}
+#[test]
+fn unsupported_hash_returns_error_instead_of_partial_header() {
+    assert!(answer(None)
+        .make_authorization_header(Some(b"unsupported-hash"), false, false)
+        .is_err());
+}
+#[test]
+fn rfc_auth_vector_still_matches() {
+    assert!(header(&answer(Some(b"auth")), b"MD5")
+        .contains("response=\"6629fae49393a05397450978507c4ef1\""));
+}
+#[test]
+fn legacy_challenge_without_qop_still_matches() {
+    let mut params = answer(None);
+    params.credentials.as_mut().unwrap().client_nonce = None;
+    let value = header(&params, b"MD5");
+    assert!(value.contains("response=\"670fd8c2df070c60b045671b8b24ff02\""));
+    assert!(!value.contains(",qop="));
+}
+#[test]
+fn auth_int_empty_body_accepts_uppercase_hash_name() {
+    let value = header(&answer(Some(b"auth-int")), b"MD5");
+    assert!(value.contains("qop=auth-int"));
+    assert!(value.contains("response=\"5e6610ecf9ba3017a4870ad48e3ad30b\""));
+}
+#[test]
+fn qop_list_whitespace_and_unknown_options_preserve_supported_choice() {
+    let value = header(&answer(Some(b"future-option, \tauth-int \t")), b"MD5");
+    assert!(value.contains("qop=auth-int"));
+    assert!(value.contains("response=\"5e6610ecf9ba3017a4870ad48e3ad30b\""));
+}
+
+#[test]
+fn carrier_auth_init_keeps_literal_qop_and_auth_a2() {
+    let value = header(&answer(Some(b"auth-init")), b"MD5");
+    assert!(value.contains(",qop=auth-init"));
+    assert!(value.contains("response=\"ec4b44bae9bef8c19c7f429b93958b5b\""));
+    assert!(value.contains(",cnonce=\"0a4f113b\",nc=00000001"));
+}
