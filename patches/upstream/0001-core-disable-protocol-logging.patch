@@ -0,0 +1,64 @@
+// Copyright 2026 rcs-rs contributors
+// SPDX-License-Identifier: Apache-2.0
+
+use rust_rcs_core::{
+    ffi::log::platform_log,
+    security::authentication::digest::{DigestAnswerParams, DigestCredentials},
+};
+use std::process::Command;
+
+#[test]
+fn protocol_log_child() {
+    if std::env::var_os("RCS_PROTOCOL_LOG_CHILD").is_none() {
+        return;
+    }
+    platform_log("test", "synthetic-private-proof");
+    let answer = DigestAnswerParams {
+        realm: b"example.test".to_vec(),
+        algorithm: Some(b"MD5".to_vec()),
+        username: b"synthetic-private-user".to_vec(),
+        uri: b"/".to_vec(),
+        challenge: None,
+        credentials: Some(DigestCredentials {
+            password: b"synthetic-private-password".to_vec(),
+            client_data: Some(b"GET".to_vec()),
+            client_nonce: None,
+            entity_digest: None,
+            extra_params: Vec::new(),
+        }),
+    };
+    assert!(answer
+        .make_authorization_header(Some(b"MD5"), true, true)
+        .is_ok());
+    let mut headers = [httparse::EMPTY_HEADER; 4];
+    let mut parsed = httparse::Response::new(&mut headers);
+    parsed
+        .parse(b"HTTP/1.1 200 OK\r\nSet-Cookie: synthetic-private-cookie\r\n\r\n")
+        .unwrap();
+    assert!(rust_rcs_core::http::response::Response::from(&parsed).is_some());
+}
+
+#[test]
+fn protocol_operations_do_not_print_credentials() {
+    let output = Command::new(std::env::current_exe().unwrap())
+        .args(["--exact", "protocol_log_child", "--nocapture"])
+        .env("RCS_PROTOCOL_LOG_CHILD", "1")
+        .output()
+        .unwrap();
+    assert!(output.status.success());
+    for stream in [&output.stdout, &output.stderr] {
+        let text = String::from_utf8_lossy(stream);
+        for private in [
+            "synthetic-private-proof",
+            "synthetic-private-user",
+            "synthetic-private-password",
+            "synthetic-private-cookie",
+            "73796e7468657469632d707269766174652d70617373776f7264",
+        ] {
+            assert!(
+                !text.to_ascii_lowercase().contains(private),
+                "protocol credential reached process output"
+            );
+        }
+    }
+}
